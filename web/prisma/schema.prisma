generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model chat_messages {
  message_id   BigInt   @id @default(autoincrement())
  room_id      Int
  sender_id    Int
  message_text String   @db.VarChar(2000)
  sent_at      DateTime @default(now()) @db.DateTime(0)
  is_deleted   Boolean  @default(false)
  rooms        rooms    @relation(fields: [room_id], references: [room_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_messages_room")
  users        users    @relation(fields: [sender_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_messages_sender")

  @@index([room_id, sent_at], map: "idx_chat_room_time")
  @@index([sender_id], map: "sender_id")
}

model friend_requests {
  request_id                               Int                            @id @default(autoincrement())
  sender_id                                Int
  receiver_id                              Int
  request_status                           friend_requests_request_status @default(pending)
  sent_at                                  DateTime                       @default(now()) @db.DateTime(0)
  responded_at                             DateTime?                      @db.DateTime(0)
  users_friend_requests_sender_idTousers   users                          @relation("friend_requests_sender_idTousers", fields: [sender_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_friend_requests_sender")
  users_friend_requests_receiver_idTousers users                          @relation("friend_requests_receiver_idTousers", fields: [receiver_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_friend_requests_receiver")

  @@unique([sender_id, receiver_id], map: "uq_friend_request_pair")
  @@index([receiver_id], map: "receiver_id")
}

model friendships {
  user_id_1                          Int
  user_id_2                          Int
  created_at                         DateTime @default(now()) @db.DateTime(0)
  users_friendships_user_id_1Tousers users    @relation("friendships_user_id_1Tousers", fields: [user_id_1], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_friendships_user_1")
  users_friendships_user_id_2Tousers users    @relation("friendships_user_id_2Tousers", fields: [user_id_2], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_friendships_user_2")

  @@id([user_id_1, user_id_2])
  @@index([user_id_2], map: "user_id_2")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model furniture_catalog {
  furniture_id  Int                         @id @default(autoincrement())
  item_name     String                      @db.VarChar(80)
  item_type     furniture_catalog_item_type
  asset_url     String?                     @db.VarChar(255)
  default_price Decimal                     @default(0.00) @db.Decimal(8, 2)
  room_items    room_items[]
}

model room_favorites {
  user_id      Int
  room_id      Int
  favorited_at DateTime @default(now()) @db.DateTime(0)
  users        users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_room_favorites_user")
  rooms        rooms    @relation(fields: [room_id], references: [room_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_room_favorites_room")

  @@id([user_id, room_id])
  @@index([room_id], map: "room_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model room_items {
  room_item_id      Int               @id @default(autoincrement())
  room_id           Int
  furniture_id      Int
  placed_by         Int
  position_x        Decimal           @default(0.00) @db.Decimal(7, 2)
  position_y        Decimal           @default(0.00) @db.Decimal(7, 2)
  rotation_deg      Int               @default(0) @db.SmallInt
  scale_factor      Decimal           @default(1.00) @db.Decimal(4, 2)
  placed_at         DateTime          @default(now()) @db.DateTime(0)
  rooms             rooms             @relation(fields: [room_id], references: [room_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_room_items_room")
  furniture_catalog furniture_catalog @relation(fields: [furniture_id], references: [furniture_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_room_items_furniture")
  users             users             @relation(fields: [placed_by], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_room_items_placed_by")

  @@index([furniture_id], map: "furniture_id")
  @@index([placed_by], map: "placed_by")
  @@index([room_id], map: "room_id")
}

model room_members {
  room_id     Int
  user_id     Int
  member_role room_members_member_role @default(member)
  joined_at   DateTime                 @default(now()) @db.DateTime(0)
  rooms       rooms                    @relation(fields: [room_id], references: [room_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_room_members_room")
  users       users                    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_room_members_user")

  @@id([room_id, user_id])
  @@index([user_id], map: "user_id")
}

model rooms {
  room_id            Int              @id @default(autoincrement())
  owner_id           Int
  room_name          String           @db.VarChar(100)
  description        String?          @db.VarChar(255)
  is_private         Boolean          @default(true)
  room_password_hash String?          @db.VarChar(255)
  wallpaper          String           @default("default-blue") @db.VarChar(120)
  created_at         DateTime         @default(now()) @db.DateTime(0)
  chat_messages      chat_messages[]
  room_favorites     room_favorites[]
  room_items         room_items[]
  room_members       room_members[]
  users              users            @relation(fields: [owner_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rooms_owner")
  watch_sessions     watch_sessions[]

  @@index([owner_id], map: "owner_id")
}

model users {
  user_id                                            Int                  @id @default(autoincrement())
  username                                           String               @unique(map: "username") @db.VarChar(40)
  email                                              String               @unique(map: "email") @db.VarChar(120)
  password_hash                                      String               @db.VarChar(255)
  display_name                                       String               @db.VarChar(80)
  avatar_url                                         String?              @db.VarChar(255)
  status_message                                     String?              @db.VarChar(160)
  created_at                                         DateTime             @default(now()) @db.DateTime(0)
  account_status                                     users_account_status @default(active)
  chat_messages                                      chat_messages[]
  friend_requests_friend_requests_sender_idTousers   friend_requests[]    @relation("friend_requests_sender_idTousers")
  friend_requests_friend_requests_receiver_idTousers friend_requests[]    @relation("friend_requests_receiver_idTousers")
  friendships_friendships_user_id_1Tousers           friendships[]        @relation("friendships_user_id_1Tousers")
  friendships_friendships_user_id_2Tousers           friendships[]        @relation("friendships_user_id_2Tousers")
  room_favorites                                     room_favorites[]
  room_items                                         room_items[]
  room_members                                       room_members[]
  rooms                                              rooms[]
  watch_sessions                                     watch_sessions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model watch_sessions {
  session_id                Int                            @id @default(autoincrement())
  room_id                   Int
  started_by                Int
  video_title               String                         @db.VarChar(160)
  video_url                 String                         @db.VarChar(500)
  playback_position_seconds Int                            @default(0)
  playback_status           watch_sessions_playback_status @default(paused)
  started_at                DateTime                       @default(now()) @db.DateTime(0)
  rooms                     rooms                          @relation(fields: [room_id], references: [room_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_watch_sessions_room")
  users                     users                          @relation(fields: [started_by], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_watch_sessions_started_by")

  @@index([room_id], map: "room_id")
  @@index([started_by], map: "started_by")
}

enum room_members_member_role {
  owner
  moderator
  member
}

enum friend_requests_request_status {
  pending
  accepted
  rejected
  cancelled
}

enum watch_sessions_playback_status {
  playing
  paused
  ended
}

enum furniture_catalog_item_type {
  furniture
  wallpaper
  decoration
}

enum users_account_status {
  active
  suspended
}
